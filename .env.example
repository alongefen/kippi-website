# Kippi Website — Environment Variables
# Copy this file to .env and fill in your values for local development.
# For Vercel/Netlify: add these as environment variables in the host dashboard.
#
# NEVER commit .env or any file containing real keys.
# The service_role key must NEVER appear in this project.

# Supabase project URL (found in: Supabase dashboard > Project Settings > API)
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (found in: Supabase dashboard > Project Settings > API)
# This key is public-safe by design — it is restricted by Row Level Security policies.
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
