---
import Base from '../layouts/Base.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
---

<Base>
  <!-- ==================== HEADER ==================== -->
  <header class="site-header">
    <a href="/" class="wordmark" aria-label="Kippi home">Kippi</a>
  </header>

  <main>

    <!-- ==================== §A HERO ==================== -->
    <!--
      Mobile: headline -> Kippi -> subcopy+form (stacked)
      Desktop: two-column grid [copy | Kippi] side by side
      Kippi is a transparent RGBA cutout — grounded by contact shadow + warm glow.
    -->
    <section class="section-hero" aria-label="Hero">
      <div class="hero-inner">

        <!-- HEADLINE — order 1 on mobile -->
        <div class="hero-copy-top">
          <h1 class="hero-headline font-display" data-reveal>
            There's a moment right before it all goes.
          </h1>
        </div>

        <!-- KIPPI HERO — order 2 on mobile, right col on desktop -->
        <div class="hero-kippi-wrap" aria-label="Kippi, seated and present">
          <!-- Warm radial glow pool — the light Kippi sits in -->
          <div class="kippi-glow" aria-hidden="true"></div>
          <!-- Contact shadow — Kippi rests ON the surface -->
          <div class="kippi-shadow" aria-hidden="true"></div>
          <!-- The character, breathing -->
          <div class="kippi-breathe">
            <img
              src="/mascot/kippi-v2-hero-seated-cut.png"
              alt="Kippi the hedgehog, seated and calm, waiting with you"
              width="520"
              height="520"
              loading="eager"
              fetchpriority="high"
              class="kippi-hero-img"
            />
          </div>
        </div>

        <!-- SUBCOPY + FORM — order 3 on mobile -->
        <div class="hero-copy-bottom">
          <p class="hero-subcopy" data-reveal>
            You ate one thing you weren't planning to. Or the day just wore you down.
            And now there's a pull you know too well — the logic that says today doesn't
            count anymore, so you might as well.
          </p>

          <p class="hero-subcopy" data-reveal>
            Kippi is a friend that shows up in that window. Before the loop closes.
            Or after, without any judgment about how it went.
          </p>

          <div class="hero-form-wrap" data-reveal>
            <WaitlistForm id="hero-form" />
          </div>
        </div>

      </div>
    </section>

    <!-- ==================== §B THE LOOP ==================== -->
    <!-- Richer warm cream. No mascot. Copy breathes. -->
    <section class="section-b" aria-label="The loop">
      <div class="section-inner">
        <h2 class="section-headline font-display" data-reveal>
          One thing off plan, and then the switch flips.
        </h2>
        <div class="body-text" data-reveal>
          <p>
            You know the feeling. It doesn't matter how the first thing happened — a dinner
            with friends, a moment of stress, a day where you were holding it together and
            then you weren't. One bite, and something in your head says: well, today's
            already gone.
          </p>
          <p>
            That's when the logic takes over. Not your logic. The other one. The one that
            says it's already over, so why stop now.
          </p>
          <p>
            Every app out there is waiting for you on the other side of this. It wants you
            to log what happened. Reflect on your triggers. Fill in a form. By the time
            you're doing that, you're already past the moment that actually mattered.
          </p>
          <p class="landing-line-light">
            What nobody has built is something for the window before. The twenty minutes
            when the loop is just starting to close.
          </p>
          <p class="landing-line-light">That's what Kippi is.</p>
        </div>
      </div>
    </section>

    <!-- ==================== §C WHAT KIPPI DOES ==================== -->
    <!-- Warmer bg-elevated. Split: copy | phone visual. -->
    <section class="section-c" aria-label="What Kippi does">
      <div class="section-inner section-inner--split">

        <div class="split-copy" data-reveal>
          <h2 class="section-headline font-display">
            Kippi says the first thing.
          </h2>
          <div class="body-text">
            <p>You don't have to know what to say. You don't have to explain yourself. You don't have to start.</p>
            <p>
              You open the app and Kippi is already there — a small message waiting. From
              there, you just talk. Kippi stays with you while the feeling rises and falls.
              It doesn't try to fix anything. It doesn't push you toward anything.
            </p>
            <p class="landing-line-light">It just doesn't leave.</p>
            <p>
              And if you open the app after a hard night — not before, but after — that
              door is just as open. Whatever the moment is, Kippi meets you there.
            </p>
          </div>
        </div>

        <div class="split-visual" data-reveal aria-label="Chat preview">
          <div class="phone-frame" role="img" aria-label="Kippi chat interface showing a warm conversation">
            <div class="phone-screen">
              <div class="chat-header">
                <div class="chat-avatar-wrap" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <circle cx="10" cy="10" r="10" fill="#C27348" opacity="0.15"/>
                    <circle cx="10" cy="10" r="5" fill="#C27348" opacity="0.35"/>
                  </svg>
                </div>
                <span class="chat-name">Kippi</span>
                <span class="chat-status">here with you</span>
              </div>
              <div class="chat-messages">
                <div class="msg msg-kippi">
                  Hey. I'm here with you right now. What's going on?
                </div>
                <div class="msg msg-user">
                  I don't know. The urge came out of nowhere.
                </div>
                <div class="msg msg-kippi">
                  That makes sense. You don't have to explain it.<br />
                  Can we just stay here for a bit?
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ==================== BRIDGE: cream to dark + PEEKING KIPPI ==================== -->
    <!--
      Peeking Kippi tucks at the section edge so she peeks INTO the dark band below.
      She's positioned absolute at the bottom of the bridge, overlapping the §D boundary.
      The contact shadow appears on the dark side — she's resting on the edge.
    -->
    <div class="bridge bridge--to-dark" aria-hidden="true">
      <div class="peek-wrap" aria-label="Kippi peeking into the next section">
        <div class="peek-glow" aria-hidden="true"></div>
        <div class="peek-shadow" aria-hidden="true"></div>
        <div class="peek-breathe">
          <img
            src="/mascot/kippi-v2-peeking-cut.png"
            alt="Kippi peering around the corner, curious"
            width="160"
            height="160"
            loading="lazy"
            class="peek-img"
          />
        </div>
      </div>
    </div>

    <!-- ==================== §D RELAPSE IS RECOVERY ==================== -->
    <!-- THE one dark band. Richer candlelight glow. Moss accent. Kippi peeks from above. -->
    <section class="section-d section-dark" aria-label="Relapse is recovery">
      <!-- Richer candlelight glow: the emotional heart -->
      <div class="relapse-candle-glow" aria-hidden="true"></div>
      <!-- Moss recovery glow -->
      <div class="relapse-moss-glow" aria-hidden="true"></div>
      <!-- Amber warmth pool -->
      <div class="relapse-amber-pool" aria-hidden="true"></div>
      <!-- Urge-wave line: decorative -->
      <svg class="urge-wave" aria-hidden="true" viewBox="0 0 1200 60" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0 50 C200 50, 300 14, 600 14 C900 14, 1000 50, 1200 50" stroke="rgba(122,158,110,0.22)" stroke-width="2" fill="none"/>
      </svg>

      <div class="section-inner">
        <h2 class="section-headline section-headline--xl font-display" data-reveal>
          Relapse is recovery.
        </h2>
        <div class="body-text body-text--dark" data-reveal>
          <p>Every app we found has a streak.</p>
          <p>
            And every streak is a number that resets when you slip. Which means the app —
            the thing you opened to help you — becomes the thing that tells you how badly
            you've done.
          </p>
          <p>
            That isn't how this works. With binge eating, slipping back is a normal part
            of the arc. Clinically expected. Not a derailment. Not a verdict on who you
            are or whether you're going to be okay.
          </p>
          <p>So there is no streak in Kippi. There's nothing to reset.</p>
          <p>
            If you open the app and the first thing you want to say is "I just binged" —
            that's a first-class door, right on the home screen.
            Kippi meets you there the same way it meets you anywhere.
          </p>
          <p class="relapse-close">Without judgment. Without making it a big thing.</p>
        </div>
      </div>
    </section>

    <!-- ==================== BRIDGE: dark to cream ==================== -->
    <div class="bridge bridge--to-cream" aria-hidden="true"></div>

    <!-- ==================== §E GROUNDED IN SOMETHING REAL ==================== -->
    <!--
      Cream section with playing Kippi (yarn) — personality beat that fills the mid-page.
      Split layout: copy on left, Kippi playing on right.
    -->
    <section class="section-e" aria-label="Grounded in something real">
      <div class="section-inner section-inner--split">

        <div class="split-copy" data-reveal>
          <h2 class="section-headline font-display">
            Not meditation and vibes.
          </h2>
          <div class="body-text">
            <p>
              The ideas Kippi draws on are the same ones used in evidence-based approaches
              to binge eating urges. Including urge surfing — the practice of riding out a
              craving rather than fighting it or giving in to it.
            </p>
            <p>
              The core idea is simple: an urge is a wave. It rises, it peaks, it falls —
              usually within twenty to thirty minutes. You don't have to defeat it. You just
              have to get to the other side.
            </p>
            <p>Kippi is built around that window.</p>
            <p class="landing-line-light">
              It isn't therapy. It won't pretend to be. It's a friend for the moment — and
              it's honest about that.
            </p>
          </div>
        </div>

        <!-- Playing Kippi: grounded in section -->
        <div class="split-visual split-visual--playing" data-reveal aria-label="Kippi playing with yarn">
          <div class="playing-glow" aria-hidden="true"></div>
          <div class="playing-shadow" aria-hidden="true"></div>
          <div class="playing-breathe">
            <img
              src="/mascot/kippi-v2-playing-cut.png"
              alt="Kippi playing happily with a ball of yarn"
              width="300"
              height="300"
              loading="lazy"
              class="playing-img"
            />
          </div>
        </div>

      </div>
    </section>

    <!-- ==================== §F CLOSING WAITLIST ==================== -->
    <!-- Warmer surface tone. Echo of the hero warmth. -->
    <section class="section-f" aria-label="Join the waitlist">
      <div class="closing-ambient" aria-hidden="true"></div>
      <div class="section-inner">
        <h2 class="section-headline section-headline--lg font-display" data-reveal>
          Kippi will be here.
        </h2>
        <p class="closing-subcopy" data-reveal>
          Be the first to know when it's ready.
        </p>
        <div class="closing-form-wrap" data-reveal>
          <WaitlistForm id="closing-form" />
        </div>
      </div>
    </section>

  </main>

  <!-- ==================== §G FOOTER ==================== -->
  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <span class="wordmark wordmark--footer">Kippi</span>
        <p class="footer-tagline">Relapse is recovery.</p>
      </div>

      <nav class="footer-links" aria-label="Footer navigation">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="mailto:hello@kippi.help">hello@kippi.help</a>
      </nav>

      <!-- SAGE-LOCKED: verbatim from Sage-approved wording. Do not alter. -->
      <p class="footer-crisis">
        If you're in crisis, struggling to stay safe, or thinking about harming yourself,
        please reach out now. In the US, call or text
        <a href="tel:988" class="crisis-link">988</a> (Suicide &amp; Crisis Lifeline),
        or call ANAD's eating-disorders helpline at
        <a href="tel:8883757767" class="crisis-link">888-375-7767</a>.
        Outside the US, please contact your local emergency services.
        Kippi is a companion — not an emergency service, and not a substitute for professional help.
      </p>

      <p class="footer-copy">&copy; 2026 Kippi</p>
    </div>
  </footer>
</Base>

<style>
  /* ==================== SITE HEADER ==================== */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: var(--space-5) var(--side-margin);
    background-color: rgba(250, 245, 238, 0.93);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .wordmark {
    font-family: 'Fraunces', serif;
    font-variation-settings: 'WONK' 0.6, 'opsz' 18;
    font-size: 22px;
    font-weight: 400;
    color: var(--text-primary);
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .wordmark:hover { color: var(--text-primary); }

  /* ==================== §A HERO ==================== */
  .section-hero {
    background-color: var(--bg-primary);
    padding: var(--space-16) var(--side-margin) var(--space-16);
  }

  /*
    Mobile: flex column with explicit order
    Desktop (>= 720px): CSS grid 2-column
  */
  .hero-inner {
    max-width: var(--wide-max);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    align-items: stretch;
  }

  .hero-copy-top {
    order: 1;
    width: 100%;
  }

  .hero-kippi-wrap {
    order: 2;
    position: relative;
    width: 100%;
    max-width: 420px;
    align-self: center;
    /* The wrap is sized to the image; glow and shadow are absolute inside */
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .hero-copy-bottom {
    order: 3;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .hero-headline {
    font-size: clamp(30px, 7vw, 54px);
    line-height: 1.12;
    color: var(--text-primary);
  }

  .hero-subcopy {
    font-size: 18px;
    line-height: 1.68;
    color: var(--text-secondary);
    max-width: 560px;
  }

  .hero-form-wrap {
    width: 100%;
    max-width: 520px;
    margin-top: var(--space-3);
  }

  /* ---- Hero Kippi grounding: transparent cutout on cream ---- */

  /* Warm radial glow: the pool of candlelight Kippi sits in */
  .kippi-glow {
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 130%;
    height: 130%;
    background: radial-gradient(
      ellipse 70% 60% at 50% 60%,
      rgba(196, 154, 60, 0.28) 0%,
      rgba(194, 115, 72, 0.16) 35%,
      rgba(250, 245, 238, 0) 68%
    );
    pointer-events: none;
    z-index: 0;
    animation: glow-breathe 5s ease-in-out infinite alternate;
  }

  /* Contact shadow: the single most important grounding cue */
  /* A soft warm-dark elliptical blur beneath Kippi on the cream surface */
  .kippi-shadow {
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    width: 70%;
    height: 32px;
    background: rgba(44, 30, 22, 0.30);
    border-radius: 50%;
    filter: blur(16px);
    pointer-events: none;
    z-index: 1;
  }

  .kippi-breathe {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    animation: kippi-breathe 5s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
    /* Ensure shadow tracks with Kippi during breathing */
    transform-origin: bottom center;
  }

  .kippi-hero-img {
    width: 100%;
    max-width: 420px;
    height: auto;
    display: block;
    /* Transparent PNG sits directly on cream — no mask needed */
  }

  @media (prefers-reduced-motion: reduce) {
    .kippi-glow    { animation: none; opacity: 0.85; }
    .kippi-breathe { animation: none; }
  }

  /* ==================== §B THE LOOP ==================== */
  .section-b {
    background-color: var(--bg-surface);
    padding: 88px var(--side-margin);
  }

  /* ==================== §C WHAT KIPPI DOES ==================== */
  .section-c {
    background-color: var(--bg-elevated);
    padding: 88px var(--side-margin);
  }

  .section-inner--split {
    max-width: var(--wide-max);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    align-items: flex-start;
  }

  .split-copy {
    flex: 1;
  }

  .split-visual {
    width: 100%;
    max-width: 300px;
    align-self: center;
  }

  /* Phone frame: light palette version */
  .phone-frame {
    background: var(--bg-primary);
    border-radius: var(--radius-2xl);
    border: 1.5px solid var(--border-default);
    padding: var(--space-4);
    box-shadow:
      0 2px 8px rgba(44, 30, 22, 0.08),
      0 8px 24px rgba(44, 30, 22, 0.06);
  }

  .phone-screen {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-surface);
  }

  .chat-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-4) var(--space-3);
    border-bottom: 1px solid var(--border-subtle);
  }

  .chat-avatar-wrap {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .chat-name {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    flex: 1;
  }

  .chat-status {
    font-size: 12px;
    color: var(--semantic-success);
    letter-spacing: 0.02em;
  }

  .chat-messages {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .msg {
    font-size: 14px;
    line-height: 1.55;
    padding: 10px 14px;
    max-width: 88%;
  }

  .msg-kippi {
    background: var(--bg-elevated);
    border-radius: 14px 14px 14px 4px;
    color: var(--text-primary);
    align-self: flex-start;
  }

  .msg-user {
    background: var(--accent-primary-subtle);
    border: 1px solid rgba(194, 115, 72, 0.25);
    border-radius: 14px 14px 4px 14px;
    color: var(--text-primary);
    align-self: flex-end;
  }

  /* ==================== BRIDGE BANDS + PEEKING KIPPI ==================== */
  .bridge {
    display: block;
    pointer-events: none;
    position: relative;
  }

  .bridge--to-dark {
    height: 120px;
    background: linear-gradient(180deg, var(--bg-elevated) 0%, #1C1410 100%);
    overflow: visible; /* allow Kippi to overlap §D */
  }

  .bridge--to-cream {
    height: 80px;
    background: linear-gradient(180deg, #1C1410 0%, var(--bg-primary) 100%);
  }

  /* Peeking Kippi container — positioned at the bottom of the bridge, right third */
  .peek-wrap {
    position: absolute;
    bottom: -28px; /* overlaps into §D dark band */
    right: clamp(48px, 10vw, 160px);
    width: 160px;
    height: 180px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    z-index: 10;
    pointer-events: none;
  }

  .peek-glow {
    position: absolute;
    bottom: -4px;
    left: 50%;
    transform: translateX(-50%);
    width: 180%;
    height: 120%;
    background: radial-gradient(
      ellipse 70% 55% at 50% 65%,
      rgba(196, 154, 60, 0.20) 0%,
      rgba(194, 115, 72, 0.10) 40%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
    animation: glow-breathe 5s ease-in-out infinite alternate;
  }

  .peek-shadow {
    position: absolute;
    bottom: -6px;
    left: 50%;
    transform: translateX(-50%);
    width: 60%;
    height: 14px;
    background: rgba(28, 20, 16, 0.38);
    border-radius: 50%;
    filter: blur(8px);
    pointer-events: none;
    z-index: 1;
  }

  .peek-breathe {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    animation: kippi-breathe 5.2s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
    transform-origin: bottom center;
  }

  .peek-img {
    width: 130px;
    height: auto;
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .peek-glow   { animation: none; opacity: 0.8; }
    .peek-breathe { animation: none; }
  }

  /* ==================== §D RELAPSE IS RECOVERY ==================== */
  .section-d {
    position: relative;
    padding: 80px var(--side-margin) 88px;
    overflow: hidden;
  }

  /* Richer candlelight glow: the emotional centre */
  .relapse-candle-glow {
    position: absolute;
    top: -60px;
    left: 50%;
    transform: translateX(-50%);
    width: 900px;
    height: 900px;
    background: radial-gradient(
      ellipse at 50% 30%,
      rgba(196, 154, 60, 0.20) 0%,
      rgba(194, 115, 72, 0.12) 28%,
      transparent 58%
    );
    pointer-events: none;
    z-index: 0;
  }

  /* Moss recovery glow: the emotional thread */
  .relapse-moss-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 800px;
    height: 600px;
    background: radial-gradient(
      ellipse at center,
      rgba(122, 158, 110, 0.18) 0%,
      rgba(122, 158, 110, 0.06) 42%,
      transparent 66%
    );
    pointer-events: none;
    z-index: 0;
  }

  /* Amber warmth pool: bottom half warmth */
  .relapse-amber-pool {
    position: absolute;
    bottom: -40px;
    left: 50%;
    transform: translateX(-50%);
    width: 700px;
    height: 400px;
    background: radial-gradient(
      ellipse at 50% 100%,
      rgba(194, 115, 72, 0.11) 0%,
      transparent 60%
    );
    pointer-events: none;
    z-index: 0;
  }

  .urge-wave {
    position: absolute;
    bottom: 32px;
    left: 0;
    width: 100%;
    height: 60px;
    pointer-events: none;
    z-index: 0;
  }

  .section-d .section-inner {
    position: relative;
    z-index: 1;
  }

  /* §D uses Warm Dark text tokens */
  .body-text--dark p {
    color: #C4A98A;
  }

  .relapse-close {
    font-family: 'Fraunces', serif;
    font-variation-settings: 'WONK' 0.6, 'opsz' 20;
    font-size: 20px !important;
    font-weight: 400;
    font-style: italic;
    color: #7A9E6E !important;
    margin-top: var(--space-3);
  }

  /* ==================== §E GROUNDED — with playing Kippi ==================== */
  .section-e {
    background-color: var(--bg-primary);
    padding: 88px var(--side-margin);
  }

  /* Playing Kippi visual wrapper */
  .split-visual--playing {
    position: relative;
    max-width: 280px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .playing-glow {
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    width: 160%;
    height: 110%;
    background: radial-gradient(
      ellipse 65% 55% at 50% 60%,
      rgba(196, 154, 60, 0.18) 0%,
      rgba(194, 115, 72, 0.10) 38%,
      transparent 68%
    );
    pointer-events: none;
