---
import Base from '../layouts/Base.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
---

<Base>
  <!-- ==================== HEADER ==================== -->
  <header class="site-header">
    <a href="/" class="wordmark" aria-label="Kippi home">Kippi</a>
    <!-- Live early-access link to the validation web app (try.kippi.help). -->
    <a href="https://try.kippi.help" class="header-cta">Talk to Kippi</a>
  </header>

  <main>

    <!-- ==================== §A HERO ==================== -->
    <!--
      Mobile: headline -> Kippi -> subcopy+form (stacked)
      Desktop: two-column grid [copy | Kippi] side by side
      Kippi is a transparent RGBA cutout - grounded by contact shadow + strengthened warm glow pool.
      v5: Kippi shrunk ~33% vs v4 (max-width 310px desktop, 280px mobile).
    -->
    <section class="section-hero" aria-label="Hero">
      <div class="hero-inner">

        <!-- HEADLINE - order 1 on mobile -->
        <div class="hero-copy-top">
          <!-- Eyebrow: lowercase category label (Sage-PASS 2026-06-14). Renders uppercase
               via the shared eyebrow style; must stay "binge eating recovery" - never
               "Binge Eating Disorder" (that crosses into a clinical claim → fresh Sage pass). -->
          <p class="hero-eyebrow" data-reveal>binge eating recovery</p>
          <h1 class="hero-headline font-display" data-reveal>
            When the urge hits, Kippi is already there.
          </h1>
        </div>

        <!-- KIPPI HERO - order 2 on mobile, right col on desktop -->
        <div class="hero-kippi-wrap" aria-label="Kippi, reaching up and present">
          <!-- Warm radial glow pool - strengthened so edges melt into cream -->
          <div class="kippi-glow" aria-hidden="true"></div>
          <!-- Secondary outer glow: wider, softer - kills the sticker silhouette -->
          <div class="kippi-glow-outer" aria-hidden="true"></div>
          <!-- Contact shadow - Kippi rests ON the surface -->
          <div class="kippi-shadow" aria-hidden="true"></div>
          <!-- The character, breathing -->
          <div class="kippi-breathe">
            <img
              src="/mascot/hero-stand-3-cut.png"
              alt="Kippi the hedgehog, standing and reaching up, here with you"
              width="1087"
              height="1563"
              loading="eager"
              fetchpriority="high"
              class="kippi-hero-img"
            />
          </div>
        </div>

        <!-- SUBCOPY + FORM - order 3 on mobile -->
        <div class="hero-copy-bottom">
          <p class="hero-subline" data-reveal>
            Kippi is a warm friend that's there in the moment before or after a binge. No judgment. No streaks.
          </p>

          <div class="hero-form-wrap" data-reveal>
            <WaitlistForm id="hero-form" />
          </div>

        </div>

      </div>
    </section>

    <!-- ==================== §A2 TRY KIPPI NOW (early web access) ==================== -->
    <!--
      Founder-approved Option A copy (2026-06-27), Sage-cleared 2026-06-30
      (marketing/content/drafts/2026-06-30-landing-try-kippi-copy.md).
      Secondary path below the hero — the waitlist stays the primary CTA.
      Vault build-guard: this copy is safe ONLY because the button links
      DIRECTLY into try.kippi.help, where the crisis footer/modal live.
      Do NOT reuse this copy on any surface that doesn't link straight into the tool.
    -->
    <section class="section-try" aria-label="Try Kippi now">
      <div class="section-inner section-try-inner">
        <h2 class="section-try-headline font-display" data-reveal>Try Kippi now</h2>
        <p class="section-try-subtext" data-reveal>
          The iPhone app is coming this summer. In the meantime, you can talk to Kippi
          right now, on the web. No account, no sign-up. If you're in the middle of
          something hard, or you just want to see what it's like, it's there.
        </p>
        <a href="https://try.kippi.help" class="section-try-cta" data-reveal>
          Open the web version
        </a>
      </div>
    </section>

    <!-- ==================== §B THE MOMENT ==================== -->
    <!-- Dark, quiet. No mascot. Poetic copy relocated from v4 hero. Copy breathes. -->
    <section class="section-b" aria-label="The moment">
      <div class="section-b-glow" aria-hidden="true"></div>
      <div class="section-inner section-b-inner">
        <div class="section-b-label" aria-hidden="true">the moment</div>
        <h2 class="section-headline font-display" data-reveal>
          There's a moment right before it all goes.
        </h2>
        <div class="body-text body-text--wide" data-reveal>
          <p>
            One thing off plan. A day that wore you down. And now there's a pull - the voice
            that says today doesn't count anymore, so you might as well.
          </p>
          <p>
            You know that switch. One moment you were fine. Then something flips, and by the time
            you notice, the window is already closing.
          </p>
          <p>
            Every other app is waiting for you on the other side. Asking you to log, reflect, fill
            in a form. By then it's too late.
          </p>
          <div class="section-b-divider" aria-hidden="true"></div>
          <p class="landing-line-light">
            Kippi is for the window.
          </p>
        </div>
      </div>
    </section>

    <!-- ==================== §B/§C SEAM: pull-up Kippi ==================== -->
    <!--
      Centered on the boundary between §B and §C.
      Paws/bottom edge sit ON the divider line; head + spines crest above into §B.
      Uses a seam-anchor wrapper at the boundary so both sections can have overflow:hidden
      without clipping Kippi. z-index above both sections; overflow:visible on the seam container.
    -->
    <div class="seam-bc" aria-label="Kippi pulling himself up over the section ledge">
      <div class="seam-bc-inner">
        <div class="pullup-glow"       aria-hidden="true"></div>
        <div class="pullup-ledge-shadow" aria-hidden="true"></div>
        <div class="pullup-breathe">
          <img
            src="/mascot/kippi-v2-pullup-cut.png"
            alt="Kippi gripping the ledge, peeking up curiously"
            width="1201"
            height="920"
            loading="lazy"
            class="pullup-img"
          />
        </div>
      </div>
    </div>

    <!-- ==================== §C WHAT KIPPI DOES ==================== -->
    <section class="section-c" aria-label="What Kippi does">

      <div class="section-inner section-inner--split">

        <div class="split-copy" data-reveal>
          <div class="section-c-label" aria-hidden="true">the companion</div>
          <h2 class="section-headline font-display">
            Kippi says the first thing.
          </h2>
          <div class="body-text">
            <p>
              You don't have to know what to say. You open the app and Kippi is already there --
              a small message waiting. You just talk. It stays with you while the feeling rises and falls.
            </p>
            <p>
              It doesn't try to fix anything. It just doesn't leave.
            </p>
            <p class="landing-line-light">
              And if you open it after a hard night - not before, but after - that door is just as open.
            </p>
          </div>
        </div>

        <!-- App screenshot: mobile card (phone) / iPhone mockup (desktop) -->
        <div class="split-visual" data-reveal aria-label="Kippi app conversation">
          <!-- Mobile: clean rounded card, no nested phone inside a phone -->
          <div class="app-card-mobile">
            <img
              src="/conversation-v1.png"
              alt="Kippi app: a warm conversation in progress"
              width="1170"
              height="2532"
              loading="lazy"
              class="app-card-screenshot"
            />
          </div>
          <!-- Desktop: full iPhone mockup -->
          <div class="iphone-mockup">
            <div class="iphone-shell">
              <div class="iphone-island" aria-hidden="true"></div>
              <div class="iphone-screen-area">
                <img
                  src="/conversation-v1.png"
                  alt="Kippi app: a warm conversation in progress"
                  width="1170"
                  height="2532"
                  loading="lazy"
                  class="iphone-screenshot"
                />
              </div>
              <div class="iphone-home-indicator" aria-hidden="true"></div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ==================== §D RELAPSE IS RECOVERY ==================== -->
    <!-- THE one dark band. Richer candlelight glow. Moss accent. -->
    <section class="section-d section-dark" aria-label="Relapse is recovery">
      <!-- Richer candlelight glow: the emotional heart -->
      <div class="relapse-candle-glow" aria-hidden="true"></div>
      <!-- Moss recovery glow -->
      <div class="relapse-moss-glow" aria-hidden="true"></div>
      <!-- Amber warmth pool -->
      <div class="relapse-amber-pool" aria-hidden="true"></div>
      <!-- Urge-wave line: decorative -->
      <svg class="urge-wave" aria-hidden="true" viewBox="0 0 1200 60" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0 50 C200 50, 300 14, 600 14 C900 14, 1000 50, 1200 50" stroke="rgba(122,158,110,0.22)" stroke-width="2" fill="none"/>
      </svg>

      <div class="section-inner">
        <h2 class="section-headline section-headline--xl font-display" data-reveal>
          Relapse is recovery.
        </h2>
        <div class="body-text body-text--dark" data-reveal>
          <p>Every other app has a streak. And every streak is a number that resets when you slip - which means the thing you opened to help you becomes the thing that scores you.</p>
          <p>
            That's not how this works. Slipping back is a normal part of the arc. Clinically expected. Not a verdict.
          </p>
          <p>There's no streak in Kippi. Nothing to reset. If the first thing you want to say is "I just binged" - that's a first-class door, right on the home screen.</p>
          <p class="relapse-close">Without judgment. Without making it a big thing.</p>
        </div>
      </div>
    </section>

    <!-- ==================== BRIDGE: dark to cream ==================== -->
    <div class="bridge bridge--to-cream" aria-hidden="true"></div>

    <!-- ==================== §E GROUNDED IN SOMETHING REAL ==================== -->
    <!--
      Cream section with playing Kippi (yarn) - personality beat.
      Split layout: copy on left, Kippi playing on right.
    -->
    <section class="section-e" aria-label="Grounded in something real">
      <div class="section-inner section-inner--split">

        <div class="split-copy" data-reveal>
          <h2 class="section-headline font-display">
            Not meditation and vibes.
          </h2>
          <div class="body-text">
            <p>
              Kippi is built around urge surfing - the evidence-based idea that a craving is a wave.
              It rises, it peaks, it falls. Usually within twenty to thirty minutes. You don't have to
              defeat it. You just have to get to the other side.
            </p>
            <p class="landing-line-light">
              It isn't therapy. It won't pretend to be. It's a friend for the moment - and it's honest about that.
            </p>
          </div>
        </div>

        <!-- Playing Kippi: grounded in section -->
        <div class="split-visual split-visual--playing" data-reveal aria-label="Kippi playing with yarn">
          <div class="playing-glow" aria-hidden="true"></div>
          <div class="playing-shadow" aria-hidden="true"></div>
          <div class="playing-breathe">
            <img
              src="/mascot/kippi-v2-playing-cut.png"
              alt="Kippi playing happily with a ball of yarn"
              width="1288"
              height="1473"
              loading="lazy"
              class="playing-img"
            />
          </div>
        </div>

      </div>
    </section>

    <!-- ==================== §F CLOSING WAITLIST ==================== -->
    <!-- Warmer surface tone. Echo of the hero warmth. -->
    <section class="section-f" aria-label="Join the waitlist">
      <div class="closing-ambient" aria-hidden="true"></div>
      <div class="section-inner">
        <h2 class="section-headline section-headline--lg font-display" data-reveal>
          Kippi will be here.
        </h2>
        <p class="closing-subcopy" data-reveal>
          Be the first to know when it's ready.
        </p>
        <div class="closing-form-wrap" data-reveal>
          <WaitlistForm id="closing-form" />
        </div>
        <p class="hero-microcopy closing-microcopy" data-reveal>No spam. Just a message when Kippi is ready.</p>
      </div>
    </section>

  </main>

  <!-- ==================== §G FOOTER ==================== -->
  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <span class="wordmark wordmark--footer">Kippi</span>
        <p class="footer-tagline">Relapse is recovery.</p>
      </div>

      <nav class="footer-links" aria-label="Footer navigation">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="mailto:hello@kippi.help">hello@kippi.help</a>
      </nav>

      <!-- SAGE-LOCKED: verbatim from Sage-approved wording. Do not alter. -->
      <p class="footer-crisis">
        If you're in crisis, struggling to stay safe, or thinking about harming yourself,
        please reach out now. In the US, call or text
        <a href="tel:988" class="crisis-link">988</a> (Suicide &amp; Crisis Lifeline),
        or call ANAD's eating-disorders helpline at
        <a href="tel:8883757767" class="crisis-link">888-375-7767</a>.
        Outside the US, please contact your local emergency services.
        Kippi is a companion - not an emergency service, and not a substitute for professional help.
      </p>

      <p class="footer-copy">&copy; 2026 Kippi</p>
    </div>
  </footer>
</Base>

<style>
  /* ================================================================
     KIPPI WEBSITE v6 - MOBILE-NATIVE STYLES
     Mobile-first: base styles = phone (390px target).
     Desktop upgrades via min-width: 720px and 1024px.
     All touch targets >= 44px. Side gutters 20-24px on mobile.
  ================================================================ */

  /* ==================== SITE HEADER ==================== */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 14px 20px;
    background-color: rgba(250, 245, 238, 0.93);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border-subtle);
    /* Wordmark left, "Talk to Kippi" CTA right */
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  /* Header CTA → live validation app. On-brand terracotta pill, >=44px tap target. */
  .header-cta {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--text-inverse);
    background-color: var(--accent-primary);
    text-decoration: none;
    padding: 0 18px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-full);
    transition: background-color 200ms var(--ease-calm);
    white-space: nowrap;
  }
  .header-cta:hover {
    background-color: var(--accent-primary-pressed);
    color: var(--text-inverse);
  }

  .wordmark {
    font-family: 'Fraunces', serif;
    font-variation-settings: 'WONK' 0.6, 'opsz' 18;
    font-size: 22px;
    font-weight: 400;
    color: var(--text-primary);
    text-decoration: none;
    letter-spacing: -0.01em;
    /* Tap target height */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .wordmark:hover { color: var(--text-primary); }

  /* ==================== §A HERO ==================== */
  /*
    Mobile: stacked column - headline, Kippi, subcopy+form.
    Kippi sized for phone: tasteful, not dominating.
    Tight vertical rhythm; no awkward gaps.
  */
  .section-hero {
    background-color: var(--bg-primary);
    padding: 48px 20px 52px;
    /* Clip decorative glows (kippi-glow, kippi-glow-outer) that extend beyond viewport */
    overflow: hidden;
  }

  .hero-inner {
    max-width: var(--wide-max);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0;
    align-items: stretch;
  }

  .hero-copy-top {
    order: 1;
    width: 100%;
    margin-bottom: 28px;
  }

  .hero-kippi-wrap {
    order: 2;
    position: relative;
    width: 100%;
    max-width: 155px;
    align-self: center;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    margin-bottom: 28px;
  }

  .hero-copy-bottom {
    order: 3;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* Hero eyebrow - lowercase "binge eating recovery" category label, rendered as the
     shared terracotta kicker (matches §B/§C eyebrows). Sage-PASS 2026-06-14. */
  .hero-eyebrow {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-primary);
    opacity: 0.7;
    margin-bottom: var(--space-3);
  }

  .hero-headline {
    /* Headline (Option 2): short + punchy. Clamp keeps it tidy on mobile (2-3 lines)
       and caps at 46px so it doesn't crowd the taller reaching-Kippi beside it. */
    font-size: clamp(26px, 6.5vw, 46px);
    line-height: 1.15;
    color: var(--text-primary);
  }

  /* Used by §F closing section microcopy */
  .hero-microcopy {
    font-size: 13px;
    color: var(--text-tertiary);
    margin-top: var(--space-2);
  }

  /* Single quiet subline - not a paragraph block, just one supporting sentence */
  .hero-subline {
    font-size: 17px;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 480px;
    margin-top: var(--space-3);
  }


  .hero-form-wrap {
    width: 100%;
    max-width: 520px;
    margin-top: var(--space-5);
  }

  /* ---- Hero Kippi grounding ---- */
  .kippi-glow {
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 160%;
    max-width: 340px;
    height: 150%;
    background: radial-gradient(
      ellipse 65% 58% at 50% 62%,
      rgba(196, 154, 60, 0.42) 0%,
      rgba(194, 115, 72, 0.28) 28%,
      rgba(194, 115, 72, 0.10) 52%,
      rgba(250, 245, 238, 0) 72%
    );
    pointer-events: none;
    z-index: 0;
    animation: glow-breathe-center 5s ease-in-out infinite alternate;
  }

  .kippi-glow-outer {
    position: absolute;
    bottom: -20px;
    left: 50%;
    transform: translateX(-50%);
    width: 240%;
    max-width: 380px;
    height: 220%;
    background: radial-gradient(
      ellipse 55% 50% at 50% 65%,
      rgba(196, 154, 60, 0.18) 0%,
      rgba(194, 115, 72, 0.08) 40%,
      rgba(250, 245, 238, 0) 68%
    );
    pointer-events: none;
    z-index: 0;
    animation: glow-breathe-center 6s ease-in-out infinite alternate-reverse;
  }

  .kippi-shadow {
    /* Contact shadow under the feet. Tightened + deepened slightly vs the old seated
       pose so the standing/reaching Kippi reads planted, not levitating (kept soft so
       it doesn't weigh down the "alive/reaching" energy). */
    position: absolute;
    bottom: -4px;
    left: 50%;
    transform: translateX(-50%);
    width: 46%;
    height: 18px;
    background: rgba(44, 30, 22, 0.42);
    border-radius: 50%;
    filter: blur(9px);
    pointer-events: none;
    z-index: 1;
  }

  .kippi-breathe {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    animation: kippi-breathe 5s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
    transform-origin: bottom center;
  }

  .kippi-hero-img {
    width: 100%;
    max-width: 155px;
    height: auto;
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .kippi-glow       { animation: none; opacity: 0.85; }
    .kippi-glow-outer { animation: none; opacity: 0.60; }
    .kippi-breathe    { animation: none; }
  }

  /* ==================== §B THE LOOP ==================== */
  .section-b {
    background-color: var(--bg-surface);
    /* Mobile: bottom padding enlarged to create a clear "climbing zone" above the §B/§C seam.
       Pull-up Kippi (90px tall) crests ~50px above the seam; add 50px crest + 30px breathing room
       on top of the baseline 64px so "Kippi is for the window." never sits under his head/spines.
       Desktop override below restores a tighter value since Kippi is in the left margin there. */
    padding: 56px 20px 144px;
    position: relative;
    overflow: hidden;
  }

  .section-b-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 700px;
    height: 460px;
    background: radial-gradient(
      ellipse 60% 50% at 50% 30%,
      rgba(196, 154, 60, 0.09) 0%,
      rgba(194, 115, 72, 0.05) 40%,
      transparent 68%
    );
    pointer-events: none;
    z-index: 0;
  }

  .section-b-inner {
    position: relative;
    z-index: 1;
  }

  .section-b-label {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-primary);
    opacity: 0.7;
    margin-bottom: var(--space-4);
  }

  .section-b-divider {
    width: 40px;
    height: 1px;
    background: var(--moss);
    opacity: 0.45;
    margin: var(--space-4) 0 var(--space-2);
  }

  .section-b-inner .section-headline {
    margin-bottom: var(--space-6);
  }

  .body-text--wide p {
    max-width: 680px;
  }

  /* ==================== §B/§C SEAM: pull-up Kippi ==================== */
  /*
    .seam-bc is a zero-height full-width row at the §B/§C boundary.
    .seam-bc-inner mirrors .section-inner (max-width 680px, centered) so
    Kippi's left edge tracks the left edge of "THE COMPANION" / the copy
    column at every viewport width - including wide desktop where padding
    alone diverges from the centered content column.
    Mobile: Kippi sits flush with §C's 20px gutter (matches section-inner padding).
    Desktop 720px+: the inner div centers and Kippi auto-aligns left of it.
  */
  .seam-bc {
    position: relative;
    height: 0;
    overflow: visible;
    z-index: 30;
    pointer-events: none;
    /* match §C section padding so the inner div edges up correctly */
    padding-left: 20px;
    padding-right: 20px;
  }

  /* mirrors .section-inner - centers the content column so Kippi's
     left edge = left edge of "THE COMPANION" eyebrow at all widths */
  .seam-bc-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    display: flex;
    justify-content: flex-start;
    align-items: flex-end;
    position: relative;
    /* Anchor the image's BOTTOM (paws) to the seam line and rise UP into §B's
       climbing zone - without this the zero-height row lets the image hang
       downward over §C's eyebrow/headline. */
    transform: translateY(-100%);
  }

  /* Warm soft glow on the ledge so Kippi is grounded */
  .pullup-glow {
    position: absolute;
    bottom: -12px;
    left: 0;
    width: 200px;
    height: 60px;
    background: radial-gradient(
      ellipse 80% 60% at 40% 50%,
      rgba(196, 154, 60, 0.28) 0%,
      rgba(194, 115, 72, 0.12) 45%,
      transparent 72%
    );
    pointer-events: none;
    z-index: 0;
    animation: glow-breathe-left 5s ease-in-out infinite alternate;
  }

  /* Faint shadow under the paws on the ledge */
  .pullup-ledge-shadow {
    position: absolute;
    bottom: -3px;
    left: 0;
    width: 100px;
    height: 8px;
    background: rgba(44, 30, 22, 0.20);
    border-radius: 50%;
    filter: blur(5px);
    pointer-events: none;
    z-index: 1;
  }

  .pullup-breathe {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    /* transform-origin at bottom keeps paws pinned to the seam line during breathe */
    animation: kippi-breathe 5.4s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
    transform-origin: bottom center;
  }

