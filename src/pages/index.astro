---
import Base from '../layouts/Base.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
---

<Base>
  <!-- ==================== HEADER ==================== -->
  <header class="site-header">
    <a href="/" class="wordmark" aria-label="Kippi home">Kippi</a>
  </header>

  <main>

    <!-- ==================== §A HERO ==================== -->
    <section class="section-hero" aria-label="Hero">
      <!-- Candlelight glow -->
      <div class="hero-glow" aria-hidden="true"></div>

      <div class="hero-inner">
        <div class="kippi-figure" data-reveal>
          <img
            src="/mascot/kippi-resting-320.png"
            srcset="/mascot/kippi-resting-320.png 320w, /mascot/kippi-resting.png 2048w"
            sizes="(min-width: 640px) 180px, 140px"
            alt="Kippi the hedgehog, sitting quietly"
            width="320"
            height="320"
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <h1 class="hero-headline font-display" data-reveal>
          When the urge comes,<br />you don't have to be alone with it.
        </h1>

        <p class="hero-subcopy" data-reveal>
          Kippi is a warm companion that sits with you through a binge urge — in the moment, not after.
          No logging. No streaks. No judgment.
        </p>

        <div class="hero-form-wrap" data-reveal>
          <WaitlistForm id="hero-form" />
        </div>
      </div>
    </section>

    <!-- ==================== §B THE HONEST PROBLEM ==================== -->
    <section class="section-text" aria-label="The honest problem">
      <div class="section-inner">
        <h2 class="section-headline font-display" data-reveal>
          Every other app asks you to log it. After.
        </h2>
        <div class="body-text" data-reveal>
          <p>
            When the urge is happening, the last thing that helps is a food diary.
            By the time you're writing it down, the moment has already passed.
          </p>
          <p>
            Kippi is built for the moment itself — the twenty or thirty minutes when it's hardest.
            You open the app, and someone is already there.
          </p>
        </div>
      </div>
    </section>

    <!-- ==================== §C WHAT KIPPI DOES ==================== -->
    <section class="section-split" aria-label="What Kippi does">
      <div class="section-inner section-inner--wide">
        <div class="split-text" data-reveal>
          <h2 class="section-headline font-display">
            Kippi sends the first message.
          </h2>
          <div class="body-text">
            <p>You don't have to know what to say. You don't have to start.</p>
            <p>
              Kippi opens with a small hello and stays — calm, unhurried — while the urge rises and falls.
              Like a friend who texts "I'm outside," and just comes and sits with you.
            </p>
          </div>
        </div>
        <div class="split-visual" data-reveal aria-label="Chat screen preview">
          <div class="phone-frame" role="img" aria-label="Kippi chat interface showing a warm conversation during a difficult moment">
            <div class="phone-screen">
              <div class="chat-header">
                <img
                  src="/mascot/kippi-listening-60.png"
                  alt=""
                  width="36"
                  height="36"
                  class="chat-avatar"
                />
                <span class="chat-name">Kippi</span>
              </div>
              <div class="chat-messages">
                <div class="msg msg-kippi">
                  Hey. I'm here with you right now. What's going on?
                </div>
                <div class="msg msg-user">
                  I don't know. The urge came out of nowhere.
                </div>
                <div class="msg msg-kippi">
                  That makes sense. You don't have to explain it.<br />
                  Can we just stay here for a bit?
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== §D RELAPSE IS RECOVERY ==================== -->
    <section class="section-relapse" aria-label="Relapse is recovery">
      <!-- Faint second glow -->
      <div class="relapse-glow" aria-hidden="true"></div>

      <div class="section-inner">
        <h2 class="section-headline section-headline--xl font-display" data-reveal>
          Relapse is recovery.
        </h2>
        <div class="body-text relapse-body" data-reveal>
          <p>
            Every binge eating app we found has a streak that resets the moment you slip.
            That isn't how recovery works.
          </p>
          <p>
            Binge eating has a high relapse rate — it's an expected part of the arc, not a failure.
            So Kippi has no streak to break.
          </p>
          <p>
            "I just binged" isn't a confession here. It's a first-class door, right on the home screen —
            and Kippi meets you there the same way it meets you anywhere. Without judgment.
          </p>
        </div>
        <div class="holding-space-figure" data-reveal aria-hidden="true">
          <img
            src="/mascot/kippi-holding-space-120.png"
            alt=""
            width="80"
            height="80"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- ==================== §E WHY A HEDGEHOG ==================== -->
    <section class="section-text" aria-label="Why a hedgehog">
      <div class="section-inner">
        <h2 class="section-headline font-display" data-reveal>
          Why a hedgehog?
        </h2>
        <div class="body-text" data-reveal>
          <p>
            Spines on the outside. Soft underneath.
            A hedgehog won't come to you if you're anxious or abrupt — it rewards patience and calm.
          </p>
          <p>
            That's the whole idea. Kippi isn't a coach cheering you on.
            It's a small, steady presence that's simply there.
          </p>
        </div>
      </div>
    </section>

    <!-- ==================== §F QUIETLY GROUNDED ==================== -->
    <section class="section-text section-text--surface" aria-label="Grounded approach">
      <div class="section-inner">
        <h2 class="section-headline font-display" data-reveal>
          Grounded in what actually works.
        </h2>
        <div class="body-text" data-reveal>
          <p>
            Kippi draws on the same ideas clinical approaches like CBT-E and DBT use for urges —
            including urge surfing, the practice of riding a craving out instead of fighting it.
          </p>
          <p>
            It isn't meditation-and-vibes. It also isn't therapy, and it won't pretend to be.
            Kippi is a companion for the moment, and it's honest about that.
          </p>
        </div>
        <!-- SAGE REVIEW FLAG: copy above references CBT-E/DBT and urge surfing - needs safety review before go-live -->
      </div>
    </section>

    <!-- ==================== §G CLOSING WAITLIST ==================== -->
    <section class="section-closing" aria-label="Join the waitlist">
      <div class="section-inner">
        <h2 class="section-headline font-display" data-reveal>
          Kippi will be here.
        </h2>
        <p class="hero-subcopy" data-reveal>
          Be the first to know when it's ready.
        </p>
        <div class="closing-form-wrap" data-reveal>
          <WaitlistForm id="closing-form" />
        </div>
      </div>
    </section>

  </main>

  <!-- ==================== §H FOOTER ==================== -->
  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <span class="wordmark wordmark--footer">Kippi</span>
        <p class="footer-tagline">Relapse is recovery.</p>
      </div>

      <nav class="footer-links" aria-label="Footer navigation">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="mailto:hello@kippi.help">hello@kippi.help</a>
      </nav>

      <!--
        SAGE REVIEW FLAG: crisis resource line copy — needs safety review before go-live.
        Provisional wording per spec §H:
      -->
      <p class="footer-crisis">
        If you're in crisis or thinking about harming yourself, please reach out for help now.
        In the US, call or text <a href="tel:988" class="crisis-link">988</a>.
        Kippi is a companion, not an emergency service.
      </p>

      <p class="footer-copy">&copy; 2026 Kippi</p>
    </div>
  </footer>
</Base>

<style>
  /* ==================== SITE HEADER ==================== */
  .site-header {
    position: relative;
    z-index: 10;
    padding: var(--space-6) var(--side-margin);
  }

  .wordmark {
    font-family: 'Fraunces', serif;
    font-variation-settings: 'WONK' 0.6, 'opsz' 18;
    font-size: 22px;
    font-weight: 400;
    color: var(--text-primary);
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .wordmark:hover { color: var(--text-primary); }

  /* ==================== HERO ==================== */
  .section-hero {
    position: relative;
    padding: var(--space-12) var(--side-margin) var(--space-20);
    display: flex;
    justify-content: center;
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    top: -120px;
    left: 50%;
    transform: translateX(-50%);
    width: 900px;
    height: 900px;
    background: radial-gradient(ellipse at center, rgba(194, 115, 72, 0.055) 0%, transparent 62%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: var(--content-max);
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-8);
  }

  .kippi-figure {
    width: 140px;
    height: 140px;
  }
  .kippi-figure img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .hero-headline {
    font-size: clamp(30px, 6vw, 52px);
    line-height: 1.15;
    color: var(--text-primary);
    max-width: 580px;
  }

  .hero-subcopy {
    font-size: 18px;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 520px;
  }

  .hero-form-wrap {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  /* ==================== SECTION BASE ==================== */
  .section-text {
    padding: var(--space-20) var(--side-margin);
  }

  .section-text--surface {
    background: var(--bg-surface);
  }

  .section-inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .section-inner--wide {
    max-width: var(--wide-max);
  }

  .section-headline {
    font-size: clamp(24px, 4vw, 38px);
    line-height: 1.2;
    color: var(--text-primary);
    margin-bottom: var(--space-8);
  }

  .section-headline--xl {
    font-size: clamp(30px, 5.5vw, 48px);
  }

  .body-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .body-text p {
    font-size: 18px;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 640px;
  }

  /* ==================== SPLIT (§C) ==================== */
  .section-split {
    padding: var(--space-20) var(--side-margin);
  }

  .section-inner--wide .split-text,
  .section-inner--wide .split-visual {
    /* Mobile: stacked */
  }

  .section-inner--wide {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    align-items: flex-start;
  }

  /* ---- Phone frame ---- */
  .phone-frame {
    width: 100%;
    max-width: 300px;
    margin: 0 auto;
    background: var(--bg-elevated);
    border-radius: var(--radius-2xl);
    border: 1.5px solid var(--border-default);
    padding: var(--space-4);
    box-shadow: 0 8px 24px rgba(28, 20, 16, 0.35);
  }

  .phone-screen {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-surface);
  }

  .chat-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-4) var(--space-3);
    border-bottom: 1px solid var(--border-subtle);
  }

  .chat-avatar {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    object-fit: contain;
    background: var(--bg-elevated);
  }

  .chat-name {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .chat-messages {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .msg {
    font-size: 14px;
    line-height: 1.55;
    padding: 10px 14px;
    max-width: 88%;
  }

  .msg-kippi {
    background: var(--bg-elevated);
    border-radius: 14px 14px 14px 4px;
    color: var(--text-primary);
    align-self: flex-start;
  }

  .msg-user {
    background: var(--accent-primary-subtle);
    border: 1px solid rgba(194, 115, 72, 0.3);
    border-radius: 14px 14px 4px 14px;
    color: var(--text-primary);
    align-self: flex-end;
  }

  /* ==================== RELAPSE IS RECOVERY (§D) ==================== */
  .section-relapse {
    position: relative;
    padding: var(--space-20) var(--side-margin);
    overflow: hidden;
  }

  .relapse-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 700px;
    height: 700px;
    background: radial-gradient(ellipse at center, rgba(194, 115, 72, 0.035) 0%, transparent 62%);
    pointer-events: none;
    z-index: 0;
  }

  .section-relapse .section-inner {
    position: relative;
    z-index: 1;
  }

  .relapse-body p {
    max-width: 600px;
  }

  .holding-space-figure {
    margin-top: var(--space-10);
  }
  .holding-space-figure img {
    width: 80px;
    height: 80px;
    object-fit: contain;
    opacity: 0.85;
  }

  /* ==================== CLOSING WAITLIST (§G) ==================== */
  .section-closing {
    padding: var(--space-20) var(--side-margin) var(--space-16);
  }

  .closing-form-wrap {
    margin-top: var(--space-6);
  }

  /* ==================== FOOTER (§H) ==================== */
  .site-footer {
    border-top: 1px solid var(--border-subtle);
    padding: var(--space-12) var(--side-margin) var(--space-10);
  }

  .footer-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .wordmark--footer {
    font-size: 18px;
  }

  .footer-tagline {
    font-family: 'Fraunces', serif;
    font-variation-settings: 'WONK' 0.6, 'opsz' 14;
    font-size: 14px;
    font-weight: 300;
    color: var(--text-tertiary);
    font-style: italic;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }

  .footer-links a {
    font-size: 15px;
    color: var(--text-tertiary);
    text-decoration: none;
  }
  .footer-links a:hover { color: var(--text-secondary); }

  .footer-crisis {
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-tertiary);
    max-width: 560px;
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-5);
  }

  .crisis-link {
    color: var(--semantic-crisis);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .crisis-link:hover { color: var(--semantic-crisis); }

  .footer-copy {
    font-size: 13px;
    color: var(--text-tertiary);
  }

  /* ==================== RESPONSIVE — DESKTOP ==================== */
  @media (min-width: 720px) {
    .site-header {
      padding: var(--space-8) var(--space-10);
    }

    .section-hero {
      padding: var(--space-16) var(--space-10) var(--space-20);
    }

    .kippi-figure {
      width: 180px;
      height: 180px;
    }

    .section-text,
    .section-split,
    .section-relapse,
    .section-closing {
      padding-top: 100px;
      padding-bottom: 100px;
      padding-left: var(--space-10);
      padding-right: var(--space-10);
    }

    .section-text--surface {
      padding-left: var(--space-10);
      padding-right: var(--space-10);
    }

    /* Split layout: side by side at desktop */
    .section-inner--wide {
      flex-direction: row;
      align-items: center;
      gap: var(--space-12);
    }

    .split-text {
      flex: 1;
    }

    .split-visual {
      flex: 0 0 280px;
    }

    .phone-frame {
      margin: 0;
    }

    .site-footer {
      padding-left: var(--space-10);
      padding-right: var(--space-10);
    }
  }

  @media (min-width: 1024px) {
    .section-text,
    .section-split,
    .section-relapse,
    .section-closing {
      padding-left: var(--space-16);
      padding-right: var(--space-16);
    }

    .section-text--surface {
      padding-left: var(--space-16);
      padding-right: var(--space-16);
    }
  }
</style>
