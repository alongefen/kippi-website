---
import Base from '../layouts/Base.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
---

<Base>
  <!-- ==================== HEADER ==================== -->
  <header class="site-header">
    <a href="/" class="wordmark" aria-label="Kippi home">Kippi</a>
  </header>

  <main>

    <!-- ==================== §A HERO ==================== -->
    <!--
      Mobile: headline -> Kippi -> subcopy+form (stacked)
      Desktop: two-column grid [copy | Kippi] side by side
      Kippi is a transparent RGBA cutout -- grounded by contact shadow + strengthened warm glow pool.
      v5: Kippi shrunk ~33% vs v4 (max-width 310px desktop, 280px mobile).
    -->
    <section class="section-hero" aria-label="Hero">
      <div class="hero-inner">

        <!-- HEADLINE -- order 1 on mobile -->
        <div class="hero-copy-top">
          <h1 class="hero-headline font-display" data-reveal>
            There's a moment right before it all goes.
          </h1>
        </div>

        <!-- KIPPI HERO -- order 2 on mobile, right col on desktop -->
        <div class="hero-kippi-wrap" aria-label="Kippi, seated and present">
          <!-- Warm radial glow pool -- strengthened so edges melt into cream -->
          <div class="kippi-glow" aria-hidden="true"></div>
          <!-- Secondary outer glow: wider, softer -- kills the sticker silhouette -->
          <div class="kippi-glow-outer" aria-hidden="true"></div>
          <!-- Contact shadow -- Kippi rests ON the surface -->
          <div class="kippi-shadow" aria-hidden="true"></div>
          <!-- The character, breathing -->
          <div class="kippi-breathe">
            <img
              src="/mascot/kippi-v2-hero-seated-cut.png"
              alt="Kippi the hedgehog, seated and calm, waiting with you"
              width="1286"
              height="1483"
              loading="eager"
              fetchpriority="high"
              class="kippi-hero-img"
            />
          </div>
        </div>

        <!-- SUBCOPY + FORM -- order 3 on mobile -->
        <div class="hero-copy-bottom">
          <p class="hero-subcopy" data-reveal>
            One thing off plan. A day that wore you down. And now there's a pull -- the voice
            that says today doesn't count anymore, so you might as well.
          </p>

          <p class="hero-subcopy" data-reveal>
            Kippi is a friend that shows up in that window. Before the loop closes.
            Or after, without judgment.
          </p>

          <div class="hero-form-wrap" data-reveal>
            <WaitlistForm id="hero-form" />
          </div>

          <p class="hero-microcopy" data-reveal>No spam. Just a message when Kippi is ready.</p>
        </div>

      </div>
    </section>

    <!-- ==================== §B THE LOOP ==================== -->
    <!-- Richer warm cream. No mascot. Copy breathes. -->
    <section class="section-b" aria-label="The loop">
      <div class="section-b-glow" aria-hidden="true"></div>
      <div class="section-inner section-b-inner">
        <div class="section-b-label" aria-hidden="true">the loop</div>
        <h2 class="section-headline font-display" data-reveal>
          One thing off plan, and then the switch flips.
        </h2>
        <div class="body-text body-text--wide" data-reveal>
          <p>
            You know the feeling. One moment you were fine. Then something says: today's already gone.
          </p>
          <p>
            Every other app is waiting for you on the other side of that moment -- asking you to log,
            reflect, fill in a form. By then the window has already closed.
          </p>
          <div class="section-b-divider" aria-hidden="true"></div>
          <p class="landing-line-light">
            Kippi is for the window.
          </p>
        </div>
      </div>
    </section>

    <!-- ==================== §C WHAT KIPPI DOES ==================== -->
    <!--
      Peeking Kippi pulls his head UP over the TOP edge of this section.
      overflow: visible so the peek element bleeds above the section boundary.
      The peek-wrap sits absolute at top:-N so only head + paws show above the line.
    -->
    <section class="section-c" aria-label="What Kippi does">

      <!-- Peeking Kippi: positioned to poke head over the top edge of §C -->
      <div class="peek-anchor" aria-label="Kippi peeking over the edge, curious">
        <div class="peek-glow" aria-hidden="true"></div>
        <div class="peek-edge-shadow" aria-hidden="true"></div>
        <div class="peek-breathe">
          <img
            src="/mascot/kippi-v2-peeking-cut.png"
            alt="Kippi peeking over the top edge, curious"
            width="871"
            height="1599"
            loading="lazy"
            class="peek-img"
          />
        </div>
      </div>

      <div class="section-inner section-inner--split section-c-split">

        <div class="split-copy" data-reveal>
          <div class="section-c-label" aria-hidden="true">the companion</div>
          <h2 class="section-headline font-display">
            Kippi says the first thing.
          </h2>
          <div class="body-text">
            <p>
              You don't have to know what to say. You open the app and Kippi is already there --
              a small message waiting. You just talk. It stays with you while the feeling rises and falls.
            </p>
            <p>
              It doesn't try to fix anything. It just doesn't leave.
            </p>
            <p class="landing-line-light">
              And if you open it after a hard night -- not before, but after -- that door is just as open.
            </p>
          </div>
        </div>

        <!-- Real iPhone mockup with conversation-v1.png screenshot -->
        <div class="split-visual" data-reveal aria-label="Kippi app on iPhone">
          <div class="iphone-mockup">
            <!-- Device outer shell -->
            <div class="iphone-shell">
              <!-- Dynamic Island -->
              <div class="iphone-island" aria-hidden="true"></div>
              <!-- Screenshot fills the screen area -->
              <div class="iphone-screen-area">
                <img
                  src="/conversation-v1.png"
                  alt="Kippi app: a warm conversation in progress"
                  width="1170"
                  height="2532"
                  loading="lazy"
                  class="iphone-screenshot"
                />
              </div>
              <!-- Home indicator -->
              <div class="iphone-home-indicator" aria-hidden="true"></div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ==================== §D RELAPSE IS RECOVERY ==================== -->
    <!-- THE one dark band. Richer candlelight glow. Moss accent. -->
    <section class="section-d section-dark" aria-label="Relapse is recovery">
      <!-- Richer candlelight glow: the emotional heart -->
      <div class="relapse-candle-glow" aria-hidden="true"></div>
      <!-- Moss recovery glow -->
      <div class="relapse-moss-glow" aria-hidden="true"></div>
      <!-- Amber warmth pool -->
      <div class="relapse-amber-pool" aria-hidden="true"></div>
      <!-- Urge-wave line: decorative -->
      <svg class="urge-wave" aria-hidden="true" viewBox="0 0 1200 60" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0 50 C200 50, 300 14, 600 14 C900 14, 1000 50, 1200 50" stroke="rgba(122,158,110,0.22)" stroke-width="2" fill="none"/>
      </svg>

      <div class="section-inner">
        <h2 class="section-headline section-headline--xl font-display" data-reveal>
          Relapse is recovery.
        </h2>
        <div class="body-text body-text--dark" data-reveal>
          <p>Every other app has a streak. And every streak is a number that resets when you slip -- which means the thing you opened to help you becomes the thing that scores you.</p>
          <p>
            That's not how this works. Slipping back is a normal part of the arc. Clinically expected. Not a verdict.
          </p>
          <p>There's no streak in Kippi. Nothing to reset. If the first thing you want to say is "I just binged" -- that's a first-class door, right on the home screen.</p>
          <p class="relapse-close">Without judgment. Without making it a big thing.</p>
        </div>
      </div>
    </section>

    <!-- ==================== BRIDGE: dark to cream ==================== -->
    <div class="bridge bridge--to-cream" aria-hidden="true"></div>

    <!-- ==================== §E GROUNDED IN SOMETHING REAL ==================== -->
    <!--
      Cream section with playing Kippi (yarn) -- personality beat.
      Split layout: copy on left, Kippi playing on right.
    -->
    <section class="section-e" aria-label="Grounded in something real">
      <div class="section-inner section-inner--split">

        <div class="split-copy" data-reveal>
          <h2 class="section-headline font-display">
            Not meditation and vibes.
          </h2>
          <div class="body-text">
            <p>
              Kippi is built around urge surfing -- the evidence-based idea that a craving is a wave.
              It rises, it peaks, it falls. Usually within twenty to thirty minutes. You don't have to
              defeat it. You just have to get to the other side.
            </p>
            <p class="landing-line-light">
              It isn't therapy. It won't pretend to be. It's a friend for the moment -- and it's honest about that.
            </p>
          </div>
        </div>

        <!-- Playing Kippi: grounded in section -->
        <div class="split-visual split-visual--playing" data-reveal aria-label="Kippi playing with yarn">
          <div class="playing-glow" aria-hidden="true"></div>
          <div class="playing-shadow" aria-hidden="true"></div>
          <div class="playing-breathe">
            <img
              src="/mascot/kippi-v2-playing-cut.png"
              alt="Kippi playing happily with a ball of yarn"
              width="1288"
              height="1473"
              loading="lazy"
              class="playing-img"
            />
          </div>
        </div>

      </div>
    </section>

    <!-- ==================== §F CLOSING WAITLIST ==================== -->
    <!-- Warmer surface tone. Echo of the hero warmth. -->
    <section class="section-f" aria-label="Join the waitlist">
      <div class="closing-ambient" aria-hidden="true"></div>
      <div class="section-inner">
        <h2 class="section-headline section-headline--lg font-display" data-reveal>
          Kippi will be here.
        </h2>
        <p class="closing-subcopy" data-reveal>
          Be the first to know when it's ready.
        </p>
        <div class="closing-form-wrap" data-reveal>
          <WaitlistForm id="closing-form" />
        </div>
        <p class="hero-microcopy closing-microcopy" data-reveal>No spam. Just a message when Kippi is ready.</p>
      </div>
    </section>

  </main>

  <!-- ==================== §G FOOTER ==================== -->
  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <span class="wordmark wordmark--footer">Kippi</span>
        <p class="footer-tagline">Relapse is recovery.</p>
      </div>

      <nav class="footer-links" aria-label="Footer navigation">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="mailto:hello@kippi.help">hello@kippi.help</a>
      </nav>

      <!-- SAGE-LOCKED: verbatim from Sage-approved wording. Do not alter. -->
      <p class="footer-crisis">
        If you're in crisis, struggling to stay safe, or thinking about harming yourself,
        please reach out now. In the US, call or text
        <a href="tel:988" class="crisis-link">988</a> (Suicide &amp; Crisis Lifeline),
        or call ANAD's eating-disorders helpline at
        <a href="tel:8883757767" class="crisis-link">888-375-7767</a>.
        Outside the US, please contact your local emergency services.
        Kippi is a companion -- not an emergency service, and not a substitute for professional help.
      </p>

      <p class="footer-copy">&copy; 2026 Kippi</p>
    </div>
  </footer>
</Base>

<style>
  /* ==================== SITE HEADER ==================== */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: var(--space-5) var(--side-margin);
    background-color: rgba(250, 245, 238, 0.93);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .wordmark {
    font-family: 'Fraunces', serif;
    font-variation-settings: 'WONK' 0.6, 'opsz' 18;
    font-size: 22px;
    font-weight: 400;
    color: var(--text-primary);
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .wordmark:hover { color: var(--text-primary); }

  /* ==================== §A HERO ==================== */
  .section-hero {
    background-color: var(--bg-primary);
    padding: var(--space-16) var(--side-margin) var(--space-16);
  }

  /*
    Mobile: flex column with explicit order
    Desktop (>= 720px): CSS grid 2-column
  */
  .hero-inner {
    max-width: var(--wide-max);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    align-items: stretch;
  }

  .hero-copy-top {
    order: 1;
    width: 100%;
  }

  .hero-kippi-wrap {
    order: 2;
    position: relative;
    width: 100%;
    /* v5: reduced from 420px mobile -- ~33% smaller */
    max-width: 280px;
    align-self: center;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .hero-copy-bottom {
    order: 3;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .hero-headline {
    font-size: clamp(30px, 7vw, 54px);
    line-height: 1.12;
    color: var(--text-primary);
  }

  .hero-subcopy {
    font-size: 18px;
    line-height: 1.68;
    color: var(--text-secondary);
    max-width: 560px;
  }

  .hero-microcopy {
    font-size: 13px;
    color: var(--text-tertiary);
    margin-top: var(--space-2);
  }

  .hero-form-wrap {
    width: 100%;
    max-width: 520px;
    margin-top: var(--space-3);
  }

  /* ---- Hero Kippi grounding: transparent cutout on cream ---- */

  /*
    v5: Strengthened warm radial glow so the edges of the PNG melt into
    the cream background rather than reading as a sharp cutout sticker.
    Two layers:
    - kippi-glow:       tighter, richer warm pool directly behind/under Kippi
    - kippi-glow-outer: wide, very soft halo that bleeds further into the cream
  */
  .kippi-glow {
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 160%;
    height: 150%;
    background: radial-gradient(
      ellipse 65% 58% at 50% 62%,
      rgba(196, 154, 60, 0.42) 0%,
      rgba(194, 115, 72, 0.28) 28%,
      rgba(194, 115, 72, 0.10) 52%,
      rgba(250, 245, 238, 0) 72%
    );
    pointer-events: none;
    z-index: 0;
    animation: glow-breathe-center 5s ease-in-out infinite alternate;
  }

  /* Outer feathered halo: the key anti-sticker layer */
  .kippi-glow-outer {
    position: absolute;
    bottom: -20px;
    left: 50%;
    transform: translateX(-50%);
    width: 240%;
    height: 220%;
    background: radial-gradient(
      ellipse 55% 50% at 50% 65%,
      rgba(196, 154, 60, 0.18) 0%,
      rgba(194, 115, 72, 0.08) 40%,
      rgba(250, 245, 238, 0) 68%
    );
    pointer-events: none;
    z-index: 0;
    animation: glow-breathe-center 6s ease-in-out infinite alternate-reverse;
  }

  /* Contact shadow: rests flush at the very bottom of the image */
  .kippi-shadow {
    position: absolute;
    bottom: -4px;
    left: 50%;
    transform: translateX(-50%);
    width: 54%;
    height: 18px;
    background: rgba(44, 30, 22, 0.38);
    border-radius: 50%;
    filter: blur(9px);
    pointer-events: none;
    z-index: 1;
  }

  .kippi-breathe {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    animation: kippi-breathe 5s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
    transform-origin: bottom center;
  }

  .kippi-hero-img {
    /* v5: mobile max-width shrunk ~33% vs v4 (was 420px) */
    width: 100%;
    max-width: 280px;
    height: auto;
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .kippi-glow       { animation: none; opacity: 0.85; }
    .kippi-glow-outer { animation: none; opacity: 0.60; }
    .kippi-breathe    { animation: none; }
  }

  /* ==================== §B THE LOOP ==================== */
  .section-b {
    background-color: var(--bg-surface);
    padding: 68px var(--side-margin) 72px;
    position: relative;
    overflow: hidden;
  }

  .section-b-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 700px;
    height: 460px;
    background: radial-gradient(
      ellipse 60% 50% at 50% 30%,
      rgba(196, 154, 60, 0.09) 0%,
      rgba(194, 115, 72, 0.05) 40%,
      transparent 68%
    );
    pointer-events: none;
    z-index: 0;
  }

  .section-b-inner {
    position: relative;
    z-index: 1;
  }

  .section-b-label {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-primary);
    opacity: 0.7;
    margin-bottom: var(--space-4);
  }

  .section-b-divider {
    width: 40px;
    height: 1px;
    background: var(--moss);
    opacity: 0.45;
    margin: var(--space-4) 0 var(--space-2);
  }

  .section-b-inner .section-headline {
    margin-bottom: var(--space-6);
  }

  .body-text--wide p {
    max-width: 680px;
  }

  /* ==================== §C WHAT KIPPI DOES ==================== */
  /*
    overflow: visible so peeking Kippi bleeds above the section top edge.
    The peek-anchor is absolutely positioned; a pt-push creates room
    so the copy doesn't sit under the peek element on mobile.
  */
  .section-c {
    background-color: var(--bg-elevated);
    padding: 68px var(--side-margin) 72px;
    position: relative;
    overflow: visible;
  }

  .section-c-split {
    /* Ensure copy starts below the peek head on mobile */
    padding-top: var(--space-12);
  }

  .section-c-label {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-primary);
    opacity: 0.7;
    margin-bottom: var(--space-4);
  }

  .section-c .section-headline {
    margin-bottom: var(--space-6);
  }

  /* ---- Peeking Kippi: head over the top ledge of §C ---- */
  /*
    peek-anchor sits absolute at top:0 of section-c.
    Negative translateY pulls most of the image ABOVE the section edge.
    Only the head and top-of-paws remain visible above the cream/elevated boundary.
    The element must be above z-index of §B content but below header (z-index: 100).
  */
  .peek-anchor {
    position: absolute;
    top: 0;
    /* Offset to the right third of the section */
    right: clamp(48px, 12vw, 200px);
    /* Actual rendered height of the peek character */
    width: 100px;
    height: 140px;
    /* Pull most of the image above the section boundary */
    transform: translateY(-70%);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    z-index: 20;
    pointer-events: none;
  }

  /* Warm glow pool on the ledge edge */
  .peek-glow {
    position: absolute;
    bottom: -6px;
    left: 50%;
    transform: translateX(-50%);
    width: 240%;
    height: 140%;
    background: radial-gradient(
      ellipse 70% 55% at 50% 68%,
      rgba(196, 154, 60, 0.22) 0%,
      rgba(194, 115, 72, 0.10) 42%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
    animation: glow-breathe 5s ease-in-out infinite alternate;
  }

  /* Soft contact shadow on the section top edge -- grounds the peek */
  .peek-edge-shadow {
    position: absolute;
    bottom: -2px;
    left: 50%;
    transform: translateX(-50%);
    width: 70%;
    height: 8px;
    background: rgba(44, 30, 22, 0.18);
    border-radius: 50%;
    filter: blur(5px);
    pointer-events: none;
    z-index: 1;
  }

  .peek-breathe {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    animation: kippi-breathe 5.2s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
    transform-origin: bottom center;
  }

  .peek-img {
    width: 90px;
    height: auto;
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .peek-glow    { animation: none; opacity: 0.8; }
    .peek-breathe { animation: none; }
  }

  /* ==================== §C SPLIT LAYOUT ==================== */
  .section-inner--split {
    max-width: var(--wide-max);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    align-items: flex-start;
  }

  .split-copy {
    flex: 1;
  }

  .split-visual {
    width: 100%;
    max-width: 260px;
    align-self: center;
  }

  /* ==================== iPhone Mockup ==================== */
  /*
    Clean modern device frame: dark bezel, dynamic island, home indicator.
    Screenshot fills the screen area. Device drop-shadow gives depth.
  */
  .iphone-mockup {
    width: 100%;
    max-width: 220px;
    margin: 0 auto;
  }

  .iphone-shell {
    position: relative;
    background: #1a1a1e;
    border-radius: 44px;
    padding: 14px 5px 10px;
    box-shadow:
      0 0 0 1.5px #3a3a3e,
      0 0 0 3px #111114,
      0 8px 24px rgba(0, 0, 0, 0.32),
      0 24px 56px rgba(0, 0, 0, 0.22),
      0 2px 6px rgba(0, 0, 0, 0.40);
    overflow: hidden;
  }

  /* Dynamic Island pill */
  .iphone-island {
    position: absolute;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    width: 88px;
    height: 26px;
    background: #000;
    border-radius: 20px;
    z-index: 4;
  }

  /* The inner screen area: screenshot fills it edge-to-edge */
  .iphone-screen-area {
    position: relative;
    border-radius: 34px;
    overflow: hidden;
    background: #000;
    /* 9:19.5 iPhone aspect ratio */
    aspect-ratio: 9 / 19.5;
  }

  .iphone-screenshot {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }

  /* Home indicator bar at the bottom */
  .iphone-home-indicator {
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: 6px;
    padding-bottom: 2px;
  }

  .iphone-home-indicator::after {
    content: '';
    display: block;
    width: 100px;
    height: 4px;
    background: rgba(255, 255, 255, 0.25);
    border-radius: 2px;
  }

  /* ==================== §D RELAPSE IS RECOVERY ==================== -->
  .section-d {
    position: relative;
    padding: 80px var(--side-margin) 88px;
    overflow: hidden;
  }

  /* No cream-to-dark bridge div needed -- §D follows §C directly */

  .relapse-candle-glow {
    position: absolute;
    top: -60px;
    left: 50%;
    transform: translateX(-50%);
    width: 900px;
    height: 900px;
    background: radial-gradient(
      ellipse at 50% 30%,
      rgba(196, 154, 60, 0.20) 0%,
      rgba(194, 115, 72, 0.12) 28%,
      transparent 58%
    );
    pointer-events: none;
    z-index: 0;
  }

  .relapse-moss-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 800px;
    height: 600px;
    background: radial-gradient(
      ellipse at center,
      rgba(122, 158, 110, 0.18) 0%,
      rgba(122, 158, 110, 0.06) 42%,
      transparent 66%
    );
