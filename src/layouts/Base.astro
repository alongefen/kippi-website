---
export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  isHome?: boolean;
}

const {
  title = "Kippi - App for Binge Eating Urges | No Judgment, No Streaks",
  description = "Kippi is a warm AI companion for binge eating urges — there with you in the moment, not after. No food logging, no calorie tracking, no streaks that reset. Based on urge surfing, an evidence-based approach. Join the waitlist or try the web version now.",
  ogImage = "/og-image.png",
  canonical,
  isHome = false,
} = Astro.props;

// JSON-LD structured data (SoftwareApplication + FAQPage + WebSite).
// Homepage-only — rendered when isHome is true (index.astro passes isHome),
// or on the root path. Copy is safety-locked (Sage ✅ #0703-1001); do not reword.
const renderStructuredData = isHome || Astro.url.pathname === "/";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "@id": "https://kippi.help/#app",
      "name": "Kippi",
      "description": "Kippi is a warm AI companion for binge eating urges. It meets you in the moment — before or after — with no food logging, no calorie tracking, and no streaks. Based on urge surfing, an evidence-based approach from DBT. A wellness companion, not a substitute for professional help.",
      "applicationCategory": "HealthApplication",
      "operatingSystem": "iOS, Web",
      "url": "https://kippi.help",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD",
        "availability": "https://schema.org/PreOrder",
        "description": "Free waitlist; iPhone app coming summer 2026. Web version available now at try.kippi.help."
      },
      "publisher": {
        "@type": "Organization",
        "name": "Kippi",
        "url": "https://kippi.help",
        "contactPoint": {
          "@type": "ContactPoint",
          "email": "hello@kippi.help",
          "contactType": "customer support"
        },
        // Founder entity link (plan B2, 2026-07-06): personal profiles belong on the founder
        // Person, not Organization sameAs. TikTok deliberately deferred — handle in flux
        // (@alon.gefen → @alonrecovers when available); add it once it settles.
        "founder": {
          "@type": "Person",
          "name": "Alon Gefen",
          "sameAs": ["https://www.instagram.com/alonrecovers/"]
        }
      },
      "keywords": "binge eating support, binge eating urge app, emotional eating app, urge surfing, no food logging, no calorie tracking, binge eating companion",
      "inLanguage": "en",
      "audience": {
        "@type": "PeopleAudience",
        "audienceType": "People experiencing binge eating urges seeking in-the-moment support"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://kippi.help/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What does Kippi do?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Kippi is a warm AI companion that's there with you during a binge eating urge — in the moment, not after. You open the app and Kippi is already there. You talk, it stays with you while the feeling rises and falls. It does not log food, track calories, or use streaks. It is based on urge surfing, the evidence-based idea that an urge is like a wave: it rises, peaks, and falls — usually within 20 to 30 minutes. You do not have to defeat it. You just have to get to the other side. Kippi is a wellness companion, not a substitute for professional help."
          }
        },
        {
          "@type": "Question",
          "name": "How is Kippi different from other binge eating apps?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most binge eating and eating disorder apps are designed for reflection — logging what you ate, filling in forms after the fact. Kippi is built for the moment before. It is there when the urge is happening, not after it. Kippi also has no streaks that reset when you slip. Clinically, relapse is a normal and expected part of recovery — not a failure. If the first thing you want to say is 'I just binged,' that is a first-class door, not a confession box. There is no food logging, no calorie tracking, and no judgment."
          }
        },
        {
          "@type": "Question",
          "name": "Is Kippi based on any evidence-based approach?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Kippi is built around urge surfing, a technique from DBT (Dialectical Behavior Therapy) that is used in evidence-based treatment for binge eating. The idea is that an urge — like a wave — rises, peaks, and naturally falls within about 20 to 30 minutes if you do not act on it. Kippi's AI companion helps you ride that window. The companion also draws on CBT-E (Cognitive Behavioral Therapy for Eating Disorders) principles, including relapse normalization. Kippi is a wellness companion, not a medical device or a replacement for therapy."
          }
        },
        {
          "@type": "Question",
          "name": "Does Kippi track food, calories, or weight?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Kippi does not ask about food, calories, portions, weight, or body size — ever. There is no logging, no tracking, and no numbers of any kind. Research consistently shows that calorie counting and food tracking can worsen binge eating for many people. Kippi does not do any of that."
          }
        },
        {
          "@type": "Question",
          "name": "Does Kippi have streaks?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Kippi has no streaks. Streaks that reset when you slip are clinically backwards for binge eating recovery — relapse is a normal and expected part of the recovery arc, not a failure. An app that resets everything you built when you slip becomes something you dread opening precisely when you need it most. Kippi stays open. Nothing resets."
          }
        },
        {
          "@type": "Question",
          "name": "Is Kippi available now?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A web version of Kippi is available now at try.kippi.help — no account, no sign-up required. You can talk to Kippi right now, whether you are in the middle of something hard or just want to see what it is like. The iPhone app is coming in summer 2026. Join the waitlist at kippi.help to be the first to know when it is ready."
          }
        },
        {
          "@type": "Question",
          "name": "What if I am in crisis or need immediate help?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Kippi is a wellness companion, not an emergency service. If you are in crisis, struggling to stay safe, or thinking about harming yourself, please reach out now. In the US, call or text 988 (Suicide and Crisis Lifeline), or call ANAD's eating disorders helpline at 888-375-7767. Outside the US, please contact your local emergency services."
          }
        }
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://kippi.help/#website",
      "url": "https://kippi.help",
      "name": "Kippi",
      "description": "Binge eating support app — AI companion for urge moments",
      "inLanguage": "en",
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://kippi.help/#{search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    }
  ]
};

const siteUrl = "https://kippi.help";
const canonicalUrl = canonical ? `${siteUrl}${canonical}` : `${siteUrl}${Astro.url.pathname}`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />

  <!-- Primary meta -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${siteUrl}${ogImage}`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="Kippi" />

  <!-- Twitter card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

  <!-- Structured data (JSON-LD): SoftwareApplication + FAQPage + WebSite. Homepage-only. -->
  {renderStructuredData && (
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  )}

  <!-- Favicon -->
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Fonts: preconnect then load -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,WONK@9..144,100..900,0..1&family=Plus+Jakarta+Sans:wght@200..800&display=swap"
    rel="stylesheet"
  />

  <!-- Sitemap -->
  <link rel="sitemap" href="/sitemap-index.xml" />

  <!-- Global styles -->
  <style is:global>
    /* ---- Reset ---- */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    /* ---- Design tokens: Warm Light (site default) ---- */
    :root {
      /* Warm Light palette - richer cream base (v4: pushed warmer), dark-brown text */
      --bg-primary:    #FAF5EE;
      --bg-surface:    #F2EAE0;
      --bg-elevated:   #EAE0D2;
      --bg-input:      #E0D4C4;

      --border-subtle:  rgba(180, 160, 140, 0.22);
      --border-default: rgba(140, 116, 96, 0.38);

      --text-primary:   #2C1E16;
      --text-secondary: #7A5C46;
      --text-tertiary:  #A08070;
      --text-inverse:   #F5EEE6;

      --accent-primary:         #C27348;
      --accent-primary-pressed: #A85C38;
      --accent-primary-subtle:  rgba(194, 115, 72, 0.12);
      --accent-secondary:       #B8896A;

      --semantic-success:  #7A9E6E;
      --semantic-crisis:   #C25A4A;

      /* Moss - recovery thread */
      --moss:        #7A9E6E;
      --moss-subtle: rgba(122, 158, 110, 0.18);
      --moss-glow:   rgba(122, 158, 110, 0.28);

      /* Amber glow - richer for v4 */
      --amber-glow:  rgba(196, 154, 60, 0.24);

      /* Spacing */
      --space-1:  4px;
      --space-2:  8px;
      --space-3:  12px;
      --space-4:  16px;
      --space-5:  20px;
      --space-6:  24px;
      --space-8:  32px;
      --space-10: 40px;
      --space-12: 48px;
      --space-16: 64px;
      --space-20: 80px;

      /* Radius */
      --radius-sm:   8px;
      --radius-md:   12px;
      --radius-lg:   16px;
      --radius-xl:   20px;
      --radius-2xl:  28px;
      --radius-full: 9999px;

      /* Easing */
      --ease-calm: cubic-bezier(0.4, 0, 0.2, 1);

      /* Layout */
      --content-max:  680px;
      --wide-max:     960px;
      --side-margin:  24px;
    }

    /* ---- Warm Dark overrides: scoped to the §D band only ---- */
    .section-dark {
      --bg-primary:    #1C1410;
      --bg-surface:    #251A14;
      --bg-elevated:   #2E211A;
      --bg-input:      #38281F;
      --border-subtle:  rgba(66, 48, 38, 0.14);
      --border-default: rgba(107, 79, 62, 0.28);
      --text-primary:   #F5EEE6;
      --text-secondary: #C4A98A;
      --text-tertiary:  #8C6B52;
      --text-inverse:   #1C1410;
      background-color: #1C1410;
      color: #F5EEE6;
    }

    html {
      /* Root is always cream — no dark flash */
      background-color: #FAF5EE;
      color: var(--text-primary);
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 18px;
      line-height: 1.6;
      letter-spacing: 0.01em;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      /* Prevent decorative glows from causing horizontal scroll */
      overflow-x: clip;
    }

    body {
      min-height: 100vh;
      background-color: var(--bg-primary);
      overflow-x: clip;
    }

    img {
      max-width: 100%;
      height: auto;
      display: block;
    }

    a {
      color: var(--text-secondary);
      text-decoration: underline;
      text-underline-offset: 3px;
      transition: color 200ms var(--ease-calm);
    }
    a:hover { color: var(--text-primary); }

    /* Focus visible: warm outline */
    :focus-visible {
      outline: 2px solid var(--accent-primary);
      outline-offset: 3px;
      border-radius: 4px;
    }

    /* ---- Typography helpers ---- */
    .font-display {
      font-family: 'Fraunces', serif;
      font-variation-settings: 'WONK' 0.6, 'opsz' 36;
      font-weight: 400;
    }

    /* ---- Scroll-reveal (fade + rise) ---- */
    @media (prefers-reduced-motion: no-preference) {
      [data-reveal] {
        opacity: 0;
        transform: translateY(18px);
        transition:
          opacity 500ms var(--ease-calm),
          transform 500ms var(--ease-calm);
      }
      [data-reveal].is-visible {
        opacity: 1;
        transform: translateY(0);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      [data-reveal] {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }
  </style>
</head>
<body>
  <slot />

  <!-- Scroll-reveal script (tiny, inline) -->
  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -60px 0px', threshold: 0.1 }
    );
    document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
  </script>
</body>
</html>
